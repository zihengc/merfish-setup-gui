<!-- 1 uL corresponds to 1.2 pump position units -->
<!-- speed 33 corresponds to 1 mL / min -->
  <pump_commands>
	<pump_cmd name="Flow 2 ml/min">
		<pump_config speed="10.4" direction="Forward"/>
	</pump_cmd>

	<pump_cmd name="Flow 1 ml/min">
		<pump_config speed="5.2" direction="Forward"/>
	</pump_cmd>

	<pump_cmd name="Flow 0.5 ml/min">
		<pump_config speed="2.6" direction="Forward"/>
	</pump_cmd>
	
	<pump_cmd name="Stop Flow">
		<pump_config speed="0.0"/>
	</pump_cmd>
</pump_commands>

